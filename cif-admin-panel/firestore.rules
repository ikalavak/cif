rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin roster (security-critical, not the same as the cosmetic
    // "admin_users" page). One doc per admin, keyed by their Firebase Auth
    // UID. Only admins can read/manage this list.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Events — admins have full control. Any signed-in attendee is allowed
    // to update ONLY the booked_count field, and only by exactly +1 or -1
    // per write — this is what powers booking/cancelling without giving
    // attendees the ability to edit anything else about an event.
    match /events/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked_count']) &&
        (
          request.resource.data.booked_count == resource.data.booked_count + 1 ||
          request.resource.data.booked_count == resource.data.booked_count - 1
        )
      );
    }

    // Bookings — doc ID is always "{eventId}_{uid}" (enforced client-side),
    // so a second "create" attempt for the same event+user is impossible.
    // Cancel = delete, rebook = create again.
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /announcements/{id} {
      allow read: if resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /venues/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /speakers/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sponsors/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Cosmetic roster shown on the admin panel's Users page — not used
    // for security decisions, only "admins" above is.
    match /admin_users/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /site_settings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Each app user's own profile doc, auto-created on first login.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
  }
}
