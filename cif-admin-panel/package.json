{
  "name": "cif-admin-panel",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:build": "npm run build",
    "check:security": "npm audit --omit=dev --audit-level=critical",
    "check:all": "npm run check:build && npm run check:security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "emulators:start": "firebase emulators:start --only auth,firestore",
    "test:ci": "concurrently -k -s first \"npm run dev\" \"firebase emulators:exec --only auth,firestore 'npx playwright test'\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "vite": "^5.4.21"
  }
}